---
import JsonTreeNode from './JsonTreeNode.astro';

interface Props {
  data: unknown;
  rootLabel?: string;
}

const { data, rootLabel = 'root' } = Astro.props;
---

<section class="json-tree">
  <ul>
    <JsonTreeNode label={rootLabel} value={data} />
  </ul>
</section>

<style>
  .json-tree {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    padding: 0.45rem;
    background: var(--sl-color-bg-inline-code);
    overflow: auto;
    max-height: 68vh;
    line-height: 1.25;
  }

  .json-tree ul {
    margin: 0;
    padding: 0;
  }
</style>
